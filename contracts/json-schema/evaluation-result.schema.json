{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbot.love/schemas/ai-optimization/v1/evaluation-result.schema.json",
  "title": "EvaluationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluationId",
    "tenantId",
    "evaluatorType",
    "evaluatorVersion",
    "rubricVersion",
    "sourceCategory",
    "scores",
    "confidence",
    "evidenceRefs",
    "reasoningSummary",
    "evaluationStatus",
    "createdAt"
  ],
  "properties": {
    "evaluationId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "runId": { "type": ["string", "null"] },
    "datasetCaseId": { "type": ["string", "null"] },
    "evaluatorType": { "type": "string", "enum": ["rule", "llm_judge", "human_expert"] },
    "evaluatorVersion": { "type": "string", "minLength": 1 },
    "judgeModelVersion": { "type": ["string", "null"] },
    "rubricVersion": { "type": "string", "minLength": 1 },
    "sourceCategory": {
      "type": "string",
      "enum": ["expert_verified", "automated_judge", "user_explicit", "model_self_eval"]
    },
    "scores": {
      "type": "object",
      "required": ["overall"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 },
        "correctness": { "type": "number", "minimum": 0, "maximum": 1 },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "citationAccuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "toolQuality": { "type": "number", "minimum": 0, "maximum": 1 },
        "safety": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "reasoningSummary": { "type": "string", "minLength": 1 },
    "evaluationStatus": {
      "type": "string",
      "enum": ["completed", "needs_human_review", "disputed", "overridden", "failed"]
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
